---
import "../styles/style.css";
import "../styles/geral.css";
import CarrosselCards from "../components/carrosselCards.astro";
import SeletorSuperior from "../components/seletorSuperior.astro";
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Cogito_Lab</title>
  </head>

  <body>
    <SeletorSuperior />
    <section id="inicio">
      <h1>Cogito <span>Lab</span></h1>
      <h2 data-traducao="inicio.ReneDescTitulo"></h2>
      <h3 data-traducao="inicio.ReneDesc"></h3>
      <h2 data-traducao="inicio.descricaoTitulo"></h2>
      <h3 data-traducao="inicio.descricao"></h3>
      <h2 data-traducao="inicio.missaoTitulo"></h2>
      <h3 data-traducao="inicio.missao"></h3>
      <h2 data-traducao="inicio.instituicoesTitulo"></h2>
      <h3 data-traducao="inicio.instituicoes"></h3>
    </section>


    <section id="pesquisas">
      <h1 data-traducao="pesquisas.titulo"></h1>
      <CarrosselCards></CarrosselCards>
    </section>

    <script>
      import "../scripts/idioma.js";
    </script>
  </body>
</html>
